---
import Base from "../layouts/Base.astro";
import { site, inquiry } from "../data/site";

// Sends to PUBLIC_FORM_ENDPOINT (Formspree, Basin, a Supabase function or similar).
// With no endpoint set, sending opens the visitor's email app instead.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const subject = `Project inquiry for ${site.fullName}`;
---

<Base title="Inquire" description={`Tell ${site.fullName} about your house or apartment.`}>
  <div class="wrap layout">
    <header>
      <h1 class="display h1">Tell us about your house</h1>
      <p class="lede">A few lines about the place, the rooms and when you'd like to start. Nadia or Tomas replies within three working days.</p>
      <dl>
        <div><dt>Email</dt><dd><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Phone</dt><dd><a class="tnum" href={`tel:${site.phoneHref}`}>{site.phone}</a></dd></div>
        <div><dt>Studio</dt><dd>{site.address.street}, {site.address.city}</dd></div>
      </dl>
    </header>

    <form
      class="inquiry"
      method="post"
      action={endpoint || `mailto:${site.email}`}
      data-endpoint={endpoint}
      data-email={site.email}
      data-subject={subject}
    >
      {
        !endpoint && (
          <p class="note" role="note">
            This form isn't connected yet, so sending it opens your email app. You can also write to{" "}
            <a href={`mailto:${site.email}?subject=${encodeURIComponent(subject)}`}>{site.email}</a>.
          </p>
        )
      }
      <input type="hidden" name="_subject" value={subject} />
      <div class="row">
        <label class="field"><span>Name</span><input name="name" autocomplete="name" required /></label>
        <label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
      </div>
      <div class="row">
        <label class="field">
          <span>Kind of project</span>
          <select name="project_type">{inquiry.types.map((t) => <option>{t}</option>)}</select>
        </label>
        <label class="field"><span>Where is it</span><input name="location" placeholder="Town or neighborhood" /></label>
      </div>
      <label class="field">
        <span>Which rooms <span class="hint">(or the whole house)</span></span>
        <input name="rooms" />
      </label>
      <div class="row">
        <label class="field">
          <span>Budget</span>
          <select name="budget">{inquiry.budgets.map((b) => <option>{b}</option>)}</select>
        </label>
        <label class="field">
          <span>Timeline</span>
          <select name="timeline">{inquiry.timelines.map((t) => <option>{t}</option>)}</select>
        </label>
      </div>
      <label class="field">
        <span>Tell us about it</span>
        <textarea name="message" rows="6" placeholder="How you use the house, what isn't working, rooms or pictures you love"></textarea>
      </label>
      <div class="actions">
        <button class="btn btn-primary" type="submit">Send inquiry</button>
        <p class="status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLFormElement>("form.inquiry").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".status")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const { endpoint, email, subject } = form.dataset;
      const data = new FormData(form);

      if (!endpoint) {
        const lines: string[] = [];
        for (const [key, value] of data.entries()) {
          if (key.startsWith("_") || !String(value).trim()) continue;
          lines.push(`${key}: ${value}`);
        }
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject ?? "")}&body=${encodeURIComponent(lines.join("\n"))}`;
        status.textContent = "Your email app should open with your answers filled in.";
        return;
      }

      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      status.textContent = "Sending";
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = "Thank you. We'll reply within three working days.";
      } catch {
        status.textContent = "";
        status.append("Sorry, that didn't send. Please email us at ");
        const link = Object.assign(document.createElement("a"), { href: `mailto:${email}`, textContent: email });
        status.append(link, ".");
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(32px, 5vw, 64px) 128px;
    align-items: start;
  }
  header {
    display: grid;
    gap: 20px;
    position: sticky;
    top: 32px;
  }
  dl {
    display: grid;
    gap: 8px;
    margin-top: 16px;
    font-size: 15px;
  }
  dl div {
    display: grid;
    grid-template-columns: 72px 1fr;
  }
  dt {
    color: var(--ink-3);
  }
  dd {
    margin: 0;
  }
  dd a {
    text-decoration: none;
  }
  .inquiry {
    display: grid;
    gap: 20px;
    padding-top: 8px;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .note {
    font-size: 14px;
    color: var(--ink-2);
    background: var(--raised);
    padding: 12px 16px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .status {
    font-size: 15px;
    color: var(--ink-2);
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
    header {
      position: static;
    }
  }
</style>
