---
import Base from "../../layouts/Base.astro";
import RoomScene from "../../components/RoomScene.astro";
import { projects, type Project } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project: p, next } = Astro.props as { project: Project; next: Project };
---

<Base title={p.name} description={p.summary}>
  <header class="wrap head">
    <p class="crumb muted"><a href="/projects">Projects</a></p>
    <h1 class="display h1">{p.name}</h1>
    <p class="muted meta">{p.location} &middot; {p.type} &middot; {p.year}</p>
  </header>

  <section class="wrap gallery" aria-roledescription="gallery" aria-label={`${p.name} pictures`} data-gallery>
    <div class="stage">
      {
        p.gallery.map((v, i) => (
          <figure class="slide" hidden={i !== 0} data-index={i}>
            <div class="frame">
              <RoomScene view={v} />
            </div>
            <figcaption>
              <span>{v.caption}</span>
              <span class="muted tnum">
                {i + 1} of {p.gallery.length}
              </span>
            </figcaption>
          </figure>
        ))
      }
      {
        p.gallery.length > 1 && (
          <div class="controls">
            <button type="button" class="nav go-prev" aria-label="Previous picture">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button type="button" class="nav go-next" aria-label="Next picture">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>
        )
      }
    </div>
    {
      p.gallery.length > 1 && (
        <div class="thumbs" role="group" aria-label="Choose a picture">
          {p.gallery.map((v, i) => (
            <button type="button" class="thumb" data-go={i} aria-label={`Picture ${i + 1}: ${v.caption}`} aria-current={i === 0 ? "true" : undefined}>
              <RoomScene view={v} label="" />
            </button>
          ))}
        </div>
      )
    }
  </section>

  <section class="wrap about" aria-label="About the project">
    <div class="brief">
      <h2 class="display">The brief</h2>
      {p.brief.map((b) => <p>{b}</p>)}
    </div>
    <aside>
      <div>
        <h2>Scope</h2>
        <ul>{p.scope.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div>
        <h2>Materials</h2>
        <ul class="swatches">
          {
            p.materials.map((m) => (
              <li>
                <span class="chip" style={`background:${m.color}`} aria-hidden="true" />
                {m.name}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>With</h2>
        <dl>
          {
            p.credits.map((c) => (
              <div>
                <dt>{c.role}</dt>
                <dd>{c.name}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </aside>
  </section>

  <nav class="wrap next-project" aria-label="Next project">
    <a href={`/projects/${next.slug}`}>
      <span class="muted">Next project</span>
      <span class="display">{next.name}</span>
    </a>
    <a class="btn btn-primary" href="/enquire">Start a project</a>
  </nav>
</Base>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>(".slide")];
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>(".thumb")];
    if (slides.length < 2) return;
    let current = 0;
    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.hidden = n !== current;
      });
      thumbs.forEach((t, n) => {
        if (n === current) t.setAttribute("aria-current", "true");
        else t.removeAttribute("aria-current");
      });
    };
    root.querySelector(".go-prev")?.addEventListener("click", () => {
      show(current - 1);
    });
    root.querySelector(".go-next")?.addEventListener("click", () => {
      show(current + 1);
    });
    thumbs.forEach((t) => {
      t.addEventListener("click", () => {
        show(Number(t.dataset.go));
      });
    });
    root.tabIndex = -1;
    document.addEventListener("keydown", (e) => {
      const tag = (e.target as HTMLElement).tagName;
      if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
  });
</script>

<style>
  .head {
    padding-block: clamp(24px, 4vw, 48px) 32px;
  }
  .crumb {
    font-size: 14px;
    margin-bottom: 12px;
  }
  .crumb a {
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--ink);
  }
  .meta {
    margin-top: 12px;
    font-size: 15px;
  }
  .stage {
    position: relative;
  }
  .frame :global(svg) {
    aspect-ratio: 2 / 1;
  }
  @media (max-width: 700px) {
    .frame :global(svg) {
      aspect-ratio: 4 / 3;
    }
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 12px;
    font-size: 15px;
  }
  .controls {
    position: absolute;
    right: 16px;
    top: 16px;
    display: flex;
    gap: 8px;
  }
  .nav {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(247 246 242 / 0.92);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 150ms var(--ease);
  }
  .nav:hover {
    background: #fff;
  }
  .thumbs {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }
  .thumb {
    width: 120px;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 150ms var(--ease), border-color 150ms var(--ease);
  }
  .thumb :global(svg) {
    aspect-ratio: 16 / 10;
  }
  .thumb:hover {
    opacity: 0.9;
  }
  .thumb[aria-current="true"] {
    opacity: 1;
    border-color: var(--ink);
  }
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    padding-block: 80px;
  }
  .brief {
    display: grid;
    gap: 16px;
    font-size: 18px;
    align-content: start;
  }
  .brief h2 {
    font-size: 32px;
    margin-bottom: 8px;
  }
  aside {
    display: grid;
    gap: 32px;
    align-content: start;
  }
  aside h2 {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-3);
    margin-bottom: 12px;
  }
  aside ul {
    display: grid;
    gap: 6px;
  }
  .swatches li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 12px;
    align-items: center;
  }
  .chip {
    width: 28px;
    height: 28px;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
  }
  dl div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 12px;
    padding-block: 4px;
  }
  dt {
    color: var(--ink-3);
  }
  dd {
    margin: 0;
  }
  .next-project {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
    padding-block: 48px 112px;
    border-top: 1px solid var(--line-strong);
  }
  .next-project a:first-child {
    display: grid;
    gap: 4px;
    text-decoration: none;
  }
  .next-project .display {
    font-size: clamp(28px, 3vw, 40px);
  }
  .next-project a:first-child:hover .display {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    figcaption {
      flex-direction: column;
      gap: 4px;
    }
    .thumb {
      width: 88px;
    }
  }
</style>
