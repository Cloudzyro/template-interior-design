---
import Base from "../../layouts/Base.astro";
import RoomScene from "../../components/RoomScene.astro";
import { projects } from "../../data/site";
---

<Base title="Projects" description="Houses and apartments by Calloway Reyes Interiors in the Hudson Valley and New York City.">
  <header class="wrap head">
    <h1 class="display h1">Projects</h1>
    <p class="lede">Farmhouses, apartments and one new build, from a single parlor to a whole house.</p>
  </header>

  <ul class="wrap list">
    {
      projects.map((p, i) => (
        <li class:list={["item", `v${i % 3}`]}>
          <a href={`/projects/${p.slug}`}>
            <span class="frame">
              <RoomScene view={p.gallery[p.cover]} />
            </span>
            <span class="text">
              <span class="name display">{p.name}</span>
              <span class="muted">
                {p.location} &middot; {p.type} &middot; {p.year}
              </span>
              <span class="summary">{p.summary}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .head {
    padding-block: clamp(32px, 5vw, 64px) 48px;
  }
  .lede {
    margin-top: 16px;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 96px 48px;
    padding-bottom: 128px;
  }
  .item a {
    display: grid;
    gap: 16px;
    text-decoration: none;
  }
  .v0 {
    grid-column: 1 / span 8;
  }
  .v1 {
    grid-column: 9 / span 4;
    margin-top: 160px;
  }
  .v2 {
    grid-column: 3 / span 8;
  }
  .v0 :global(svg),
  .v2 :global(svg) {
    aspect-ratio: 16 / 10;
  }
  .v1 :global(svg) {
    aspect-ratio: 4 / 5;
  }
  .text {
    display: grid;
    gap: 4px;
  }
  .name {
    font-size: 28px;
  }
  .item a:hover .name {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .text .muted {
    font-size: 14px;
  }
  .summary {
    color: var(--ink-2);
    max-width: 34rem;
    margin-top: 4px;
  }
  @media (max-width: 860px) {
    .list {
      grid-template-columns: 1fr;
      gap: 64px;
    }
    .v0,
    .v1,
    .v2 {
      grid-column: 1;
      margin-top: 0;
    }
    .v1 :global(svg) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
